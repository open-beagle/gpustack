{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/gpustack/main.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceRoot}/.venv",
      },
      "args": [
        "start",
        "--port=6081",
        "--worker-ip=127.0.0.1",
        "--worker-name=WSL-Debian-1",
        "--data-dir=${env:HOME}/windstack",
        "--bootstrap-password=123456",
        "--worker-s3-host=oss-cn-qingdao.aliyuncs.com:443",
        "--worker-s3-access-key=",
        "--worker-s3-secret-key=",
        "--worker-s3-ssl",
        "--worker-s3-use-virtual-hosted-style",
        "--worker-s3-region="
      ],
      "cwd": "${workspaceRoot}"
    }
  ]
}
